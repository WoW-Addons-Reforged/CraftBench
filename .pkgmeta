package-as: CraftBench

ignore:
    - "Scripts"
    - "*.md"
    - ".luacheckrc"
    - ".gitignore"
    - ".gitattributes"
    - "CHANGELOG.md"
    - "README.md"

externals:
    # Ace3 (GitHub: WoWUIDev/Ace3)
    Libs/LibStub:
        url: https://github.com/WoWUIDev/Ace3
        path: LibStub
    Libs/CallbackHandler-1.0:
        url: https://github.com/WoWUIDev/Ace3
        path: CallbackHandler-1.0
    Libs/AceAddon-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceAddon-3.0
    Libs/AceEvent-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceEvent-3.0
    Libs/AceHook-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceHook-3.0
    Libs/AceTimer-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceTimer-3.0
    Libs/AceConfig-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceConfig-3.0
    Libs/AceConsole-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceConsole-3.0
    Libs/AceLocale-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceLocale-3.0
    Libs/AceDB-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceDB-3.0
    Libs/AceDBOptions-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceDBOptions-3.0
    Libs/AceGUI-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceGUI-3.0
    Libs/AceBucket-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceBucket-3.0
    Libs/AceSerializer-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceSerializer-3.0
    Libs/AceComm-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceComm-3.0
