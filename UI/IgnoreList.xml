<!--
#
#  Template for all the buttons we use to display items in the ignore list
#
-->
<Frame name="CraftForgeIgnoreListItemButtonTemplate_Player" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="90" y="16"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
				<Size>
					<AbsDimension x="90" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
</Frame>

<Frame name="CraftForgeIgnoreListItemButtonTemplate_RecipeLink" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="90" y="16"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
				<Size>
					<AbsDimension x="90" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
</Frame>

<Frame name="CraftForgeIgnoreListItemButtonTemplate_RecipeID" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="30" y="16"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
				<Size>
					<AbsDimension x="30" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
</Frame>

<Frame name="CraftForgeIgnoreListItemButtonTemplate" hidden="true" virtual="true">
	<Size>
		<AbsDimension x="140" y="18"/>
	</Size>
	<Frames>
		<Frame name="$parentPlayer" inherits="CraftForgeIgnoreListItemButtonTemplate_Player">
			<Anchors>
				<Anchor point="LEFT" >
					<Offset>
						<AbsDimension x="0" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
		 <Frame name="$parentRecipeID" inherits="CraftForgeIgnoreListItemButtonTemplate_RecipeID">
			<Anchors>
				<Anchor point="LEFT" relativeTo="$parentPlayer" relativePoint="RIGHT">
					<Offset>
						<AbsDimension x="0" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
		 <Frame name="$parentRecipeLink" inherits="CraftForgeIgnoreListItemButtonTemplate_RecipeLink">
			<Anchors>
				<Anchor point="LEFT" relativeTo="$parentRecipeID" relativePoint="RIGHT">
					<Offset>
						<AbsDimension x="0" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
	</Frames>
	<Scripts>
		<OnLoad>
			self:RegisterForClicks("RightButtonUp")
		</OnLoad>
		<OnClick>
			<!-- right clicking will remove this entry. -->
			if button == "RightButton" then
				CraftForge:DeleteIgnoreEntry(self.index, self.player, self.id)
			end
		</OnClick>
	</Scripts>
</Frame>

<Frame name="CraftForgeIgnoreList" parent="UIParent" toplevel="true" movable="true" enableMouse="true" resizable="true" hidden="true" inherits="BackdropTemplate">
	<Size><AbsDimension x="320" y="150"/></Size>
	<Anchors>
		<Anchor point="CENTER"/>
	</Anchors>
	<Frames>
		<Button name="CraftForgeIgnoreListCloseButton" inherits="UIPanelCloseButton" parent="CraftForgeIgnoreList">
			<Anchors>
				<Anchor point="TOPRIGHT" relativeTo="CraftForgeIgnoreList" relativePoint="TOPRIGHT">
					<Offset>
						<AbsDimension x="-2" y="-2"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					HideUIPanel(CraftForgeIgnoreList)
				</OnClick>
			</Scripts>
		</Button>
		<Frame name="CraftForgeIgnoreListParent" parent="CraftForgeIgnoreList">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeIgnoreList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="5" y="-35"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeIgnoreList" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-5" y="30"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
		<ScrollFrame name="CraftForgeIgnoreListList" inherits="FauxScrollFrameTemplate" parent="CraftForgeIgnoreListParent">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeIgnoreListParent" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="5" y="-5"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeIgnoreListParent" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-27" y="5"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnVerticalScroll>
					FauxScrollFrame_OnVerticalScroll(self, offset, CRAFTFORGE_IGNORE_LIST_HEIGHT, CraftForge.IgnoreList_OnScroll)
				</OnVerticalScroll>
			</Scripts>
		</ScrollFrame>
		<Button name="CraftForgeIgnoreListButton1" inherits="CraftForgeIgnoreListItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeIgnoreListList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="1" y="-1"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Button>
		<!-- rest of the buttons are created dynamically -->
	</Frames>
</Frame>
</Ui>

