<!--
#
#  Template for all the buttons we use to display items in the optional list
#
-->
	<Frame name="CraftForgeModifiedListItemTemplate" hidden="false" virtual="true">
		<Size>
			<AbsDimension x="190" y="20"/>
		</Size>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentCount" inherits="GameFontNormal" justifyH="RIGHT" justifyV="MIDDLE">
					<Size>
						<AbsDimension x="48" y="20"/>
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</FontString>
				<FontString name="$parentNeeded" inherits="GameFontNormal" justifyH="RIGHT" justifyV="MIDDLE">
					<Size>
						<AbsDimension x="32" y="20"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
							<Offset>
								<AbsDimension x="18" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
				</FontString>
				<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT" justifyV="MIDDLE">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentNeeded" relativePoint="RIGHT" />
						<Anchor point="RIGHT" relativeTo="$parentCount" relativePoint="LEFT" />
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<!-- A button for the icon -->
			<button name="$parentIcon">
				<Size>
					<AbsDimension x="20" y="20"/>
				</Size>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentTexture"/>
					</Layer>
				</Layers>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
			</button>
			<Button name="$parentAdd">
				<Size>
					<AbsDimension x="20" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentCount" relativePoint="LEFT" />
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel()+2)
						self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
					</OnLoad>
					<OnClick>
						CraftForge:ModifiedItemCount(self, button, 1)
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Addons\CraftForge\Icons\Buttons\NextPage-Up"/>
				<PushedTexture file="Interface\Addons\CraftForge\Icons\Buttons\NextPage-Down"/>
				<DisabledTexture file="Interface\Addons\CraftForge\Icons\Buttons\NextPage-Disabled"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>
			<EditBox name="$parentInput" letters="3" historyLines="0" numeric="true" autoFocus="false">
				<Size>
					<AbsDimension x="30" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentAdd" relativePoint="LEFT" />
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentLeft" file="Interface\Common\Common-Input-Border">
							<Size>
								<AbsDimension x="8" y="20"/>
							</Size>
							<Anchors>
								<Anchor point="TOPLEFT">
									<Offset>
										<AbsDimension x="-5" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0" right="0.0625" top="0" bottom="0.625"/>
						</Texture>
						<Texture name="$parentRight" file="Interface\Common\Common-Input-Border">
							<Size>
								<AbsDimension x="8" y="20"/>
							</Size>
							<Anchors>
								<Anchor point="RIGHT">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0.9375" right="1.0" top="0" bottom="0.625"/>
						</Texture>
						<Texture name="$parentMiddle" file="Interface\Common\Common-Input-Border">
							<Size>
								<AbsDimension x="10" y="20"/>
							</Size>
							<Anchors>
								<Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
								<Anchor point="RIGHT" relativeTo="$parentRight" relativePoint="LEFT"/>
							</Anchors>
							<TexCoords left="0.0625" right="0.9375" top="0" bottom="0.625"/>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel()+2)
					</OnLoad>
					<OnEnterPressed>
						self:ClearFocus()
						CraftForge:ModifyItemCount(self, button)
					</OnEnterPressed>
					<OnEscapePressed>
						self:ClearFocus()
						CraftForge:ResetItemCount(self, button)
					</OnEscapePressed>
					<OnEditFocusLost>
						self:HighlightText(0, 0)
					</OnEditFocusLost>
					<OnEditFocusGained>
						self:HighlightText()
					</OnEditFocusGained>
				</Scripts>
				<FontString inherits="ChatFontNormal"/>
			</EditBox>
			<Button name="$parentSub">
				<Size>
					<AbsDimension x="20" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentInput" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="-5" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel()+2)
						self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
					</OnLoad>
					<OnClick>
						CraftForge:ModifiedItemCount(self, button, -1)
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Addons\CraftForge\Icons\Buttons\PrevPage-Up"/>
				<PushedTexture file="Interface\Addons\CraftForge\Icons\Buttons\PrevPage-Down"/>
				<DisabledTexture file="Interface\Addons\CraftForge\Icons\Buttons\PrevPage-Disabled"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
			</OnLoad>
			<OnEnter>
				CraftForge:ModifiedButtonOnEnter(self, CraftForgeFrame.selectedSkill, self:GetID())
			</OnEnter>
			<OnLeave>
				CraftForge:ModifiedButtonOnLeave(self, CraftForgeFrame.selectedSkill, self:GetID())
			</OnLeave>
			<OnUpdate>
				CursorOnUpdate(self)
			</OnUpdate>
			<OnClick>
				if ( button == "LeftButton" and IsShiftKeyDown() ) then
				<!-- Put a link to the *item* in chat into the current chat edit box -->
					local link = CraftForge:GetModifiedItemLink(CraftForge.selectedSkill, self:GetID())
					if not ChatEdit_InsertLink(link) then
						CraftForge:XMLDebugLink("ModifiedItemLink: link= ", link)
					end
				else
				<!-- generic click action -->
					CraftForge:ModifiedButtonOnClick(self, button, CraftForge.selectedSkill, self:GetID())
				end
			</OnClick>
		</Scripts>
	</Frame>

<CheckButton name="CraftForgeModifiedListCheckButtonTemplate" virtual="true">
	<Size>
		<AbsDimension x="20" y="20"/>
	</Size>
	<Layers>
		<Layer level="ARTWORK">
			<FontString name="$parentText" inherits="GameFontHighlight">
				<Anchors>
					<Anchor point="RIGHT" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="0" y="1"/>
						</Offset>
					</Anchor>
				</Anchors>
			</FontString>
		</Layer>
	</Layers>
	<NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
	<PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
	<HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
	<CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
	<DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>
</CheckButton>

<CheckButton name="CraftForgeModifiedListCheckButtonTemplate2" virtual="true">
	<Size>
		<AbsDimension x="20" y="20"/>
	</Size>
	<Layers>
		<Layer level="ARTWORK">
			<FontString name="$parentText" inherits="GameFontHighlight">
				<Anchors>
					<Anchor point="LEFT" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="0" y="1"/>
						</Offset>
					</Anchor>
				</Anchors>
			</FontString>
		</Layer>
	</Layers>
	<NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
	<PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
	<HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
	<CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
	<DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>
</CheckButton>

<Frame name="CraftForgeModifiedList" parent="UIParent" toplevel="true" movable="true" enableMouse="true" resizable="true" hidden="true" clampedToScreen="true" inherits="BackdropTemplate">
	<Size><AbsDimension x="420" y="240"/></Size>
	<Anchors>
		<Anchor point="CENTER"/>
	</Anchors>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="CraftForgeModifiedNeeded" inherits="GameFontHighlight" justifyH="RIGHT" justifyV="MIDDLE">
				<Size>
					<AbsDimension x="30" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeModifiedList" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-30" y="10"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
			<FontString name="CraftForgeModifiedLabel" inherits="GameFontHighlight" text="Needed:" justifyH="LEFT" justifyV="MIDDLE">
				<Size>
					<AbsDimension x="60" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeModifiedNeeded" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
	<Frames>
		<Button name="CraftForgeModifiedListCloseButton" inherits="UIPanelCloseButton" parent="CraftForgeModifiedList">
			<Anchors>
				<Anchor point="TOPRIGHT" relativeTo="CraftForgeModifiedList" relativePoint="TOPRIGHT">
					<Offset>
						<AbsDimension x="-2" y="-2"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					HideUIPanel(CraftForgeModifiedList)
				</OnClick>
			</Scripts>
		</Button>
		<CheckButton name="CraftForgeModifiedBestQuality" inherits="CraftForgeModifiedListCheckButtonTemplate2">
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativeTo="CraftForgeModifiedList" relativePoint="BOTTOMLEFT">
					<Offset>
						<AbsDimension x="10" y="10"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ModifiedListToggleBestQuality()
					CraftForge:UpdateModifiedListWindow()
				</OnClick>
			</Scripts>
		</CheckButton>
		<Frame name="CraftForgeModifiedListParent" parent="CraftForgeModifiedList">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeModifiedList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="5" y="-35"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeModifiedList" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-5" y="35"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
		<ScrollFrame name="CraftForgeModifiedListList" inherits="FauxScrollFrameTemplate" parent="CraftForgeModifiedListParent">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeModifiedListParent" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="5" y="-5"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeModifiedListParent" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-27" y="5"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnVerticalScroll>
					FauxScrollFrame_OnVerticalScroll(self, offset, CRAFTFORGE_MODIFIED_LIST_HEIGHT, CraftForge.ModifiedList_OnScroll)
				</OnVerticalScroll>
			</Scripts>
		</ScrollFrame>
		<Button name="CraftForgeModifiedListButton1" inherits="CraftForgeModifiedListItemTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeModifiedListList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="1" y="-1"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Button>
		<!-- rest of the buttons are created dynamically -->
	</Frames>
</Frame>
</Ui>

