<!--
 #
 #  Template for all the buttons used in the list of notes for the recipe
 #
-->
<Frame name="CraftForgeNoteItemButtonTemplate" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="190" y="48"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
				<Size>
					<AbsDimension x="160" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="18" y="-1"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
			<FontString name="$parentNotes" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
				<Size>
					<AbsDimension x="180" y="32"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="1" y="-20"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
	<Frames>
		<!-- A button for the icon -->
		<button name="$parentIcon">
			<Size>
				<AbsDimension x="16" y="16"/>
			</Size>
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="1" y="-1"/>
					</Offset>
				</Anchor>
			</Anchors>
		</button>
	</Frames>
	<Attributes>
        <Attribute name="notes_key" value="item:-1"/>
    </Attributes>
	<Scripts>
		<OnClick>
			CraftForge:RecipeNote_OnClick(self)
		</OnClick>
	</Scripts>
</Frame>

<!--
 #
 # A frame for displaying the recipe notes
 #
-->
<Frame name="CraftForgeRecipeNotesFrame" parent="CraftForgeFrame" inherits="BackdropTemplate">
	<Size>
		<AbsDimension x="200" y="380"/>
	</Size>
	<Anchors>
		<Anchor point="TOPLEFT" relativeTo="CraftForgeFrame" relativePoint="TOPRIGHT">
			<Offset>
				<AbsDimension x="-1" y="-75"/>
			</Offset>
		</Anchor>
	</Anchors>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentLabel" inherits="GameFontHighlight" text="Notes" justifyH="LEFT">
				<Size>
					<AbsDimension x="100" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="CraftForgeRecipeNotesFrame" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="6" y="-6"/>
						</Offset>
					</Anchor>
				</Anchors>
			</FontString>
		</Layer>
	</Layers>

	<Frames>
		<!--
	    #
	    # A button on the top right to close the window
	    #
	    -->
		<Button name="CraftForgeNotesCloseButton" inherits="UIPanelCloseButton">
            <Anchors>
                <Anchor point="TOPRIGHT" relativeTo="CraftForgeRecipeNotesFrame" relativePoint="TOPRIGHT">
                    <Offset>
                        <AbsDimension x="-1" y="-1"/>
                    </Offset>
                </Anchor>
            </Anchors>
			<Scripts>
				<OnClick>
					HideUIPanel(CraftForgeRecipeNotesFrame);
				</OnClick>
			</Scripts>
        </Button>

        <ScrollFrame name="CraftForgeNotesList" inherits="FauxScrollFrameTemplate" parent="CraftForgeRecipeNotesFrame">
			<Size>
				<AbsDimension x="170" y="345"/>
			</Size>
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeRecipeNotesFrame" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="2" y="-30"/>
					</Offset>
				</Anchor>
			</Anchors>
		    <Scripts>
				<OnVerticalScroll>
				    FauxScrollFrame_OnVerticalScroll(self, offset, CRAFTFORGE_NOTES_ITEM_HEIGHT, CraftForge.NotesList_OnScroll);
				</OnVerticalScroll>
			</Scripts>
		</ScrollFrame>
		<Button name="CraftForgeNotesButton1" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="3" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Button>
		<Button name="CraftForgeNotesButton2" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesButton1" relativePoint="BOTTOMLEFT"/>
			</Anchors>
		</Button>
		<Button name="CraftForgeNotesButton3" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesButton2" relativePoint="BOTTOMLEFT"/>
			</Anchors>
		</Button>
		<Button name="CraftForgeNotesButton4" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesButton3" relativePoint="BOTTOMLEFT"/>
			</Anchors>
		</Button>
		<Button name="CraftForgeNotesButton5" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesButton4" relativePoint="BOTTOMLEFT"/>
			</Anchors>
		</Button>
		<Button name="CraftForgeNotesButton6" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesButton5" relativePoint="BOTTOMLEFT"/>
			</Anchors>
		</Button>
		<Button name="CraftForgeNotesButton7" inherits="CraftForgeNoteItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeNotesButton6" relativePoint="BOTTOMLEFT"/>
			</Anchors>
		</Button>
    </Frames>
</Frame>

</Ui>
