<!--
#
#  Template for all the buttons we use to display items in the shopping list
#
-->
<Frame name="CraftForgeShoppingListItemButtonTemplate_Count" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="30" y="16"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
				<Size>
					<AbsDimension x="30" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
</Frame>

<Frame name="CraftForgeShoppingListItemButtonTemplate_Name" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="230" y="16"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
				<Size>
					<AbsDimension x="230" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
</Frame>

<Frame name="CraftForgeShoppingListItemButtonTemplate_Player" hidden="false" virtual="true">
	<Size>
		<AbsDimension x="50" y="16"/>
	</Size>
	<Layers>
		<Layer level="OVERLAY">
			<FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
				<Size>
					<AbsDimension x="50" y="0"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Color r="1" g="1" b="1" a="1"/>
			</FontString>
		</Layer>
	</Layers>
</Frame>

<Frame name="CraftForgeShoppingListItemButtonTemplate" hidden="true" virtual="true">
	<Size>
		<AbsDimension x="330" y="16"/>
	</Size>
	<Frames>
		<Frame name="$parentCount" inherits="CraftForgeShoppingListItemButtonTemplate_Count">
			<Anchors>
				<Anchor point="LEFT"/>
			</Anchors>
		</Frame>
		<Frame name="$parentName" inherits="CraftForgeShoppingListItemButtonTemplate_Name">
			<Anchors>
				<Anchor point="LEFT">
					<Offset>
						<AbsDimension x="34" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
		<Frame name="$parentPlayer" inherits="CraftForgeShoppingListItemButtonTemplate_Player">
			<Anchors>
				<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
					<Offset>
						<AbsDimension x="268" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
	</Frames>
	<Scripts>
		<OnLoad>
			self:RegisterForClicks("LeftButtonUp","RightButtonUp")
		</OnLoad>
		<OnClick>
			<!-- shift clicking will insert a link to the recipe in the chat window. -->
			if button == "LeftButton" and IsShiftKeyDown() then
				local name,link = C_Item.GetItemInfo(self.id)
				if not ChatEdit_InsertLink(self.count .. "x" .. link) then
					CraftForge:XMLDebugLink("ShoppingListItemLink: link= ", link)
				end
			end
			<!-- control clicking will remove this player's entries. -->
			if button == "LeftButton" and IsControlKeyDown() then
				CraftForge:ClearShoppingList(self.player)
			end
			<!-- right clicking will remove this player's entries. -->
			if button == "RightButton" then
				CraftForge:ClearShoppingList(self.player)
			end
		</OnClick>
		<OnEnter>
			CraftForge:ShoppingListButton_OnEnter(self)
		</OnEnter>
		<OnLeave>
			GameTooltip:Hide()
		</OnLeave>
	</Scripts>
</Frame>

<!--
	#
	# Template used when creating checkboxes
	#
	-->
<CheckButton name="CraftForgeShoppingListCheckButtonTemplate" virtual="true">
	<Size>
		<AbsDimension x="20" y="20"/>
	</Size>
	<Layers>
		<Layer level="ARTWORK">
			<FontString name="$parentText" inherits="GameFontHighlightSmall">
				<Anchors>
					<Anchor point="RIGHT" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="0" y="1"/>
						</Offset>
					</Anchor>
				</Anchors>
			</FontString>
		</Layer>
	</Layers>
	<NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
	<PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
	<HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
	<CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
	<DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>
</CheckButton>

<CheckButton name="CraftForgeShoppingListCheckButtonTemplate2" virtual="true">
	<Size>
		<AbsDimension x="20" y="20"/>
	</Size>
	<Layers>
		<Layer level="ARTWORK">
			<FontString name="$parentText" inherits="GameFontHighlightSmall">
				<Anchors>
					<Anchor point="LEFT" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="0" y="1"/>
						</Offset>
					</Anchor>
				</Anchors>
			</FontString>
		</Layer>
	</Layers>
	<NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
	<PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
	<HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
	<CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
	<DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>
</CheckButton>

<!--
 #
 #  The shopping list window ....
 #
-->
<Frame name="CraftForgeShoppingList" toplevel="true" movable="true" clampedToScreen="true" resizable="true" parent="UIParent" enableMouse="true" hidden="true" inherits="BackdropTemplate">
	<Size>
		<AbsDimension x="385" y="240"/>
	</Size>

	<Frames>

		<!--
		#
		# A button on the top right to close the window
		#
		-->
		<Button name="CraftForgeShoppingListCloseButton" inherits="UIPanelCloseButton" parent="CraftForgeShoppingList">
			<Anchors>
				<Anchor point="TOPRIGHT" relativeTo="CraftForgeShoppingList" relativePoint="TOPRIGHT">
					<Offset>
						<AbsDimension x="-2" y="-2"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					HideUIPanel(CraftForgeShoppingList)
				</OnClick>
			</Scripts>
		</Button>

		<!--
		#
		# A button to retrieve all the mats from the bank
		#
		-->
		<Button name="CraftForgeShoppingListRetrieveButton" inherits="UIPanelButtonTemplate" text="Retrieve" parent="CraftForgeShoppingList">
			<Size>
				<AbsDimension x="70" y="22"/>
			</Size>
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMLEFT">
					<Offset>
						<AbsDimension x="170" y="50"/> <!--  x="5" is the edge -->
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:GetReagentsFromBanks()
				</OnClick>
			</Scripts>
		</Button>
		<!--
		# Shopping List Auctionator button
		-->
		<Button name="CraftForgeSLAuctionatorButton" inherits="UIPanelButtonTemplate" text="Auctionator" parent="CraftForgeShoppingList">
			<Size>
				<AbsDimension x="85" y="22"/>
			</Size>
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMLEFT">
					<Offset>
						<AbsDimension x="170" y="50"/> <!--  x="5" is the edge -->
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:AuctionatorSearch(true)
				</OnClick>
			</Scripts>
		</Button>

		<!--
		#
		# Check boxes for various recipe filtering options.
		#
		-->
		<CheckButton name="CraftForgeShowQueuesFromAllAlts" inherits="CraftForgeShoppingListCheckButtonTemplate">
			<Anchors>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-10" y="50"/> <!-- 50 is the next row up -->
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ShoppingListToggleShowAlts()
					CraftForge:UpdateShoppingListWindow(false)
				</OnClick>
			</Scripts>
		</CheckButton>

		<CheckButton name="CraftForgeShowQueuesFromSameFaction" inherits="CraftForgeShoppingListCheckButtonTemplate">
			<Anchors>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-10" y="30"/> <!-- 50 is the next row up -->
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ShoppingListToggleSameFaction()
					CraftForge:UpdateShoppingListWindow(false)
				</OnClick>
			</Scripts>
		</CheckButton>

		<CheckButton name="CraftForgeShowQueuesIncludeGuild" inherits="CraftForgeShoppingListCheckButtonTemplate">
			<Anchors>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-10" y="10"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ShoppingListToggleIncludeGuild()
					CraftForge:UpdateShoppingListWindow(false)
				</OnClick>
			</Scripts>
		</CheckButton>

		<CheckButton name="CraftForgeShowQueuesIgnoreOnHand" inherits="CraftForgeShoppingListCheckButtonTemplate2">
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMLEFT">
					<Offset>
						<AbsDimension x="10" y="50"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ShoppingListToggleIgnoreOnHand()
					CraftForge:UpdateShoppingListWindow(false)
				</OnClick>
			</Scripts>
		</CheckButton>

		<CheckButton name="CraftForgeShowQueuesInItemOrder" inherits="CraftForgeShoppingListCheckButtonTemplate2">
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMLEFT">
					<Offset>
						<AbsDimension x="10" y="30"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ShoppingListToggleItemOrder()
					CraftForge:UpdateShoppingListWindow(false)
				</OnClick>
			</Scripts>
		</CheckButton>

		<CheckButton name="CraftForgeShowQueuesMergeItems" inherits="CraftForgeShoppingListCheckButtonTemplate2">
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMLEFT">
					<Offset>
						<AbsDimension x="10" y="10"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					CraftForge:ShoppingListToggleMergeItems()
					CraftForge:UpdateShoppingListWindow(false)
				</OnClick>
			</Scripts>
		</CheckButton>

		<!--
		#
		# The list of known recipes on the left hand side
		#
		-->
		<Frame name="CraftForgeShoppingListParent" parent="CraftForgeShoppingList">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeShoppingList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="5" y="-35"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeShoppingList" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-5" y="70"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Frame>
		<ScrollFrame name="CraftForgeShoppingListList" inherits="FauxScrollFrameTemplate" parent="CraftForgeShoppingListParent">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeShoppingListParent" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="5" y="-5"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativeTo="CraftForgeShoppingListParent" relativePoint="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-27" y="5"/>
					</Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnVerticalScroll>
					FauxScrollFrame_OnVerticalScroll(self, offset, CRAFTFORGE_SHOPPING_LIST_HEIGHT, CraftForge.ShoppingList_OnScroll)
				</OnVerticalScroll>
			</Scripts>
		</ScrollFrame>
		<Button name="CraftForgeShoppingListButton1" inherits="CraftForgeShoppingListItemButtonTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativeTo="CraftForgeShoppingListList" relativePoint="TOPLEFT">
					<Offset>
						<AbsDimension x="2" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</Button>
		<!-- buttons 2 ... whatever are created dynamically in the CraftForge:UpdateShoppingListWindow() function-->
	</Frames>
</Frame>

</Ui>

